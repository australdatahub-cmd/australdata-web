---
import Layout from '../layouts/Layout.astro';

const pilares = [
  {
    chip: 'CC0',
    titulo: 'Gratis y de uso libre',
    texto:
      'Todo lo que publicamos es gratuito. Descarga, usa, modifica y comparte cada archivo para cualquier fin, incluso comercial, sin pedir permiso ni pagar. El material está dedicado al dominio público (CC0 1.0).',
  },
  {
    chip: 'RAW',
    titulo: 'Solo material original',
    texto:
      'Recibimos únicamente archivos originales, sin editar (RAW en fotografía), con sus metadatos intactos: fecha, hora, coordenadas y datos del equipo. Listos para auditar y analizar.',
  },
  {
    chip: '100% real',
    titulo: 'Todo real, sin IA',
    texto:
      'Nada en la biblioteca es generado por inteligencia artificial. Cada registro es una captura real hecha por una persona, declarada por su autor y revisada por nuestra curaduría.',
  },
  {
    chip: 'Ciencia abierta',
    titulo: 'Compromiso con la observación',
    texto:
      'Existimos para registrar y resguardar los fenómenos naturales del hemisferio sur y ponerlos al alcance de la comunidad científica, aficionada y del público en general.',
  },
];
---

<Layout
  title="AustralData.org | Registros científicos reales, gratuitos y de uso libre"
  description="Descarga gratis fotografías y videos originales de fenómenos naturales del hemisferio sur. Material real, sin IA, de uso libre (CC0)."
  activePage="inicio"
>
  <!-- Portada -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-semibold mb-6">
      <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
      Ciencia abierta · Gratis · Sin IA
    </div>

    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight leading-tight max-w-4xl mx-auto">
      Registros científicos reales, de alta calidad y de uso libre
    </h1>
    <p class="text-base sm:text-lg text-gray-600 mt-6 max-w-2xl mx-auto font-normal leading-relaxed">
      Una biblioteca pública de fotografías y videos originales de fenómenos naturales del hemisferio sur.
      Descarga archivos en su máxima calidad, gratis y sin pedir permiso, para investigar, enseñar, crear o simplemente observar.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/biblioteca" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm px-6 py-3.5 rounded-xl shadow-sm transition">
        Explorar y descargar
      </a>
      <a href="/subir" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white border border-gray-300 hover:border-gray-400 text-gray-700 font-semibold text-sm px-6 py-3.5 rounded-xl shadow-sm transition">
        Aportar un registro
      </a>
    </div>
  </section>

  <!-- Nuestros compromisos -->
  <section class="px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto pb-16">
    <h2 class="text-center text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">Nuestro compromiso</h2>
    <p class="text-center text-sm text-gray-500 mt-2 max-w-xl mx-auto">
      Lo que encuentras aquí es abierto, verificable y hecho con respeto por la observación científica.
    </p>

    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {pilares.map((p) => (
        <div class="bg-white border border-gray-200/80 rounded-2xl p-6 shadow-sm">
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-blue-700 bg-blue-50 border border-blue-100 rounded-md px-2 py-1">
            {p.chip}
          </span>
          <h3 class="mt-4 text-base font-bold text-gray-900">{p.titulo}</h3>
          <p class="mt-2 text-xs text-gray-600 leading-relaxed">{p.texto}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Invitación final -->
  <section class="px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto pb-20">
    <div class="bg-white border border-gray-200/80 rounded-2xl p-8 shadow-sm text-center">
      <h2 class="text-lg sm:text-xl font-bold text-gray-900">La biblioteca crece con tu aporte</h2>
      <p class="text-sm text-gray-600 mt-2 max-w-xl mx-auto leading-relaxed">
        Si tienes registros originales de la naturaleza del hemisferio sur, súbelos. Si prefieres apoyar de otra forma,
        una donación ayuda a mantener la plataforma abierta y gratuita para todos.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/subir" class="inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-5 py-2.5 rounded-xl transition">
          Aportar un registro
        </a>
        <a href="/donaciones" class="inline-flex items-center justify-center bg-white border border-gray-300 hover:border-gray-400 text-gray-700 text-xs font-semibold px-5 py-2.5 rounded-xl transition">
          Apoyar con una donación
        </a>
      </div>
    </div>
  </section>
</Layout>
