---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AustralData.org - Infraestructura Abierta de Datos Científicos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-800 min-h-screen antialiased flex flex-col justify-between">
    
    <!-- Componente Header Global -->
    <Header activePage="inicio" />

    <!-- Contenido Principal -->
    <main class="flex-1">
      <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
          Infraestructura Abierta de Datos
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight leading-tight max-w-4xl mx-auto">
          Preservación e Ingesta de Registros Científicos Fotográficos
        </h1>
        <p class="text-base sm:text-lg text-gray-600 mt-6 max-w-2xl mx-auto font-normal leading-relaxed">
          Facilitamos a investigadores y donantes el respaldo de material fotográfico sin procesar (RAW/EXIF intacto) para la auditoría, análisis georreferenciado y ciencia abierta.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/biblioteca" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm px-6 py-3.5 rounded-xl shadow-sm transition">
            Explorar Biblioteca
          </a>
          <a href="/subir" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white border border-gray-300 hover:border-gray-400 text-gray-700 font-semibold text-sm px-6 py-3.5 rounded-xl shadow-sm transition">
            Donar Registros
          </a>
        </div>
      </section>
    </main>

    <!-- Componente Footer Global -->
    <Footer />

  </body>
</html>