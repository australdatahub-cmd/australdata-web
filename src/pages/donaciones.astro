---
import Layout from '../layouts/Layout.astro';

// Enlace de pago Webpay.cl (Transbank) de la Fundación
const WEBPAY_URL = 'https://www.webpay.cl/form-pay/403905';
---

<Layout
  title="Donaciones - AustralData.org"
  description="Aporta a la ciencia abierta del hemisferio sur: donaciones a la Fundación Austral de Observación Científica y Datos Abiertos con tarjeta o transferencia."
  activePage="donaciones"
>
  <div class="max-w-3xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-6">

      <!-- Encabezado -->
      <div class="text-center mb-4">
        <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Apoya la Ciencia Abierta</h1>
        <p class="text-sm text-gray-500 mt-2 max-w-xl mx-auto">
          AustralData.org es una iniciativa sin fines de lucro administrada por la Fundación Austral de Observación Científica y Datos Abiertos.
        </p>
      </div>

      <!-- Destino de los aportes -->
      <section class="bg-white border border-gray-200/80 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
      <!-- Destino de los aportes -->
      <section class="bg-white border border-gray-200/80 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
        <h2 class="text-lg font-semibold text-gray-900">¿Cómo contribuyen las donaciones?</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-gray-600">
          <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
            <h3 class="font-bold text-gray-800 mb-1">Operación y resguardo</h3>
            <p>Mantenimiento de los sistemas que capturan, almacenan y resguardan los registros de fenómenos naturales del hemisferio sur.</p>
          </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-gray-600">
          <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
            <h3 class="font-bold text-gray-800 mb-1">Operación y resguardo</h3>
            <p>Mantenimiento de los sistemas que capturan, almacenan y resguardan los registros de fenómenos naturales del hemisferio sur.</p>
          </div>
          <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
            <h3 class="font-bold text-gray-800 mb-1">Instrumentación técnica y digital</h3>
            <p>Herramientas y plataformas para registrar, procesar y compartir datos abiertos de calidad.</p>
            <h3 class="font-bold text-gray-800 mb-1">Instrumentación técnica y digital</h3>
            <p>Herramientas y plataformas para registrar, procesar y compartir datos abiertos de calidad.</p>
          </div>
          <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
            <h3 class="font-bold text-gray-800 mb-1">Difusión y educación</h3>
            <p>Divulgación científica para la comunidad académica, aficionada y el público en general.</p>
            <h3 class="font-bold text-gray-800 mb-1">Difusión y educación</h3>
            <p>Divulgación científica para la comunidad académica, aficionada y el público en general.</p>
          </div>
        </div>
      </section>

      <!-- Opción 1: Tarjeta (Webpay) -->
      <section class="bg-white border border-gray-200/80 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
        <h2 class="text-lg font-semibold text-gray-900">Dona con tarjeta</h2>
        <p class="text-xs text-gray-500">
          Pago seguro a través de Webpay (Transbank). Tú eliges el monto; puedes pagar con tarjeta de débito o crédito.
          Los datos de tu tarjeta los gestiona Transbank y no pasan por este sitio.
        </p>
        <div class="text-center pt-2">
          <a
            href={WEBPAY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-3 rounded-xl transition shadow-xs"
      </section>

      <!-- Opción 1: Tarjeta (Webpay) -->
      <section class="bg-white border border-gray-200/80 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
        <h2 class="text-lg font-semibold text-gray-900">Dona con tarjeta</h2>
        <p class="text-xs text-gray-500">
          Pago seguro a través de Webpay (Transbank). Tú eliges el monto; puedes pagar con tarjeta de débito o crédito.
          Los datos de tu tarjeta los gestiona Transbank y no pasan por este sitio.
        </p>
        <div class="text-center pt-2">
          <a
            href={WEBPAY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-3 rounded-xl transition shadow-xs"
          >
            Donar con Webpay
            Donar con Webpay
          </a>
        </div>
      </section>

      <!-- Opción 2: Transferencia -->
      <section class="bg-white border border-gray-200/80 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
        <h2 class="text-lg font-semibold text-gray-900">Dona por transferencia bancaria</h2>

        <dl class="text-xs divide-y divide-gray-100 border border-gray-100 rounded-xl overflow-hidden">
          <div class="flex items-center justify-between gap-3 px-4 py-3 bg-gray-50">
            <div>
              <dt class="text-gray-500">Titular</dt>
              <dd class="font-semibold text-gray-800" id="d-titular">Fundación Austral de Observación Científica y Datos Abiertos</dd>
            </div>
            <button type="button" data-copy="d-titular" class="copy-btn shrink-0 text-blue-600 hover:text-blue-800 font-semibold">Copiar</button>
          </div>
          <div class="flex items-center justify-between gap-3 px-4 py-3">
            <div>
              <dt class="text-gray-500">RUT</dt>
              <dd class="font-semibold text-gray-800" id="d-rut">65.273.167-8</dd>
            </div>
            <button type="button" data-copy="d-rut" class="copy-btn shrink-0 text-blue-600 hover:text-blue-800 font-semibold">Copiar</button>
          </div>
          <div class="flex items-center justify-between gap-3 px-4 py-3 bg-gray-50">
            <div>
              <dt class="text-gray-500">Banco</dt>
              <dd class="font-semibold text-gray-800" id="d-banco">BancoEstado</dd>
            </div>
            <button type="button" data-copy="d-banco" class="copy-btn shrink-0 text-blue-600 hover:text-blue-800 font-semibold">Copiar</button>
          </div>
          <div class="flex items-center justify-between gap-3 px-4 py-3">
            <div>
              <dt class="text-gray-500">Tipo de cuenta</dt>
              <dd class="font-semibold text-gray-800" id="d-tipo">Chequera Electrónica (Cuenta Comunidad)</dd>
            </div>
            <button type="button" data-copy="d-tipo" class="copy-btn shrink-0 text-blue-600 hover:text-blue-800 font-semibold">Copiar</button>
          </div>
          <div class="flex items-center justify-between gap-3 px-4 py-3 bg-gray-50">
            <div>
              <dt class="text-gray-500">Número de cuenta</dt>
              <dd class="font-semibold text-gray-800" id="d-cuenta">23572374696</dd>
            </div>
            <button type="button" data-copy="d-cuenta" class="copy-btn shrink-0 text-blue-600 hover:text-blue-800 font-semibold">Copiar</button>
          </div>
          <div class="flex items-center justify-between gap-3 px-4 py-3">
            <div>
              <dt class="text-gray-500">Correo</dt>
              <dd class="font-semibold text-gray-800" id="d-correo">contacto@australdata.org</dd>
            </div>
            <button type="button" data-copy="d-correo" class="copy-btn shrink-0 text-blue-600 hover:text-blue-800 font-semibold">Copiar</button>
          </div>
        </dl>

        <p class="text-xs text-gray-500">
          Antes de confirmar la transferencia, verifica que el titular y el RUT coincidan con los de arriba.
        </p>

        <!-- Aviso opcional de aporte -->
        <details class="group border border-gray-100 rounded-xl">
          <summary class="cursor-pointer select-none px-4 py-3 text-xs font-semibold text-gray-800">
            Avísanos de tu aporte (opcional)
          </summary>
          <div class="px-4 pb-4 pt-1 space-y-3">
            <p class="text-xs text-gray-500">
              Una transferencia no nos dice quién la hizo. Si quieres que registremos tu aporte con tu nombre y poder escribirte, completa este formulario. No es necesario para que tu donación llegue.
            </p>

            <form id="form-aviso" class="space-y-3 text-xs" novalidate>
              <!-- Campo trampa anti-spam: las personas no lo ven -->
              <div class="hidden" aria-hidden="true">
                <label>No completar <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <label class="block">
                  <span class="text-gray-600">Monto transferido (CLP) *</span>
                  <input name="monto" type="number" min="1" step="1" required inputmode="numeric"
                    class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </label>
                <label class="block">
                  <span class="text-gray-600">Fecha de la transferencia *</span>
                  <input name="fecha" type="date" required
                    class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </label>
                <label class="block">
                  <span class="text-gray-600">Nombre (opcional)</span>
                  <input name="nombre" type="text" maxlength="100" autocomplete="name"
                    class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </label>
                <label class="block">
                  <span class="text-gray-600">Correo (opcional)</span>
                  <input name="email" type="email" maxlength="120" autocomplete="email"
                    class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </label>
              </div>

              <label class="block">
                <span class="text-gray-600">Mensaje (opcional)</span>
                <textarea name="mensaje" rows="2" maxlength="500"
                  class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
              </label>

              <label class="flex items-start gap-2 text-gray-600">
                <input name="acepta" type="checkbox" required class="mt-0.5" />
                <span>Acepto que la Fundación use estos datos solo para registrar mi aporte y, si dejé un correo, escribirme sobre él. *</span>
              </label>

              <button type="submit" id="aviso-btn"
                class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2.5 rounded-xl transition">
                Enviar aviso
              </button>
              <p id="aviso-msg" class="text-xs" role="status" aria-live="polite"></p>
            </form>
          </div>
        </details>
      </section>

      <!-- Transparencia -->
      <section class="text-center text-xs text-gray-500 space-y-2 px-2">
        <p>
          La Fundación registra cada aporte monetario y lo destina a los fines señalados en sus estatutos.
          Por ahora, la Fundación <strong>no emite certificados de donación para beneficios tributarios</strong>.
        </p>
        <p>
          Para donaciones institucionales, aportes en especie u otras consultas,
          <a href="/contacto" class="text-blue-600 hover:text-blue-800 font-semibold">contáctanos</a>.
        </p>
      </section>
    </div>
</Layout>

<script>
  function iniciarDonaciones() {
    if (!document.getElementById('form-aviso') && !document.querySelector('.copy-btn')) return;
        // Botones "Copiar"
        document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const target = document.getElementById(btn.dataset.copy || '');
            if (!target) return;
            try {
              await navigator.clipboard.writeText((target.textContent || '').trim());
              const original = btn.textContent;
              btn.textContent = '¡Copiado!';
              setTimeout(() => { btn.textContent = original; }, 1500);
            } catch {
              btn.textContent = 'Selecciona y copia';
            }
          });
        });

        // Formulario "Avísanos de tu aporte"
        const form = document.getElementById('form-aviso') as HTMLFormElement | null;
        const msg = document.getElementById('aviso-msg');
        const submitBtn = document.getElementById('aviso-btn') as HTMLButtonElement | null;

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!msg || !submitBtn) return;

          if (!form.checkValidity()) {
            msg.textContent = 'Revisa los campos marcados con * y vuelve a intentar.';
            msg.className = 'text-xs text-red-600';
            return;
          }

          const data = new FormData(form);
          const payload = {
            monto: Number(data.get('monto')),
            fecha: String(data.get('fecha') || ''),
            nombre: String(data.get('nombre') || ''),
            email: String(data.get('email') || ''),
            mensaje: String(data.get('mensaje') || ''),
            acepta: data.get('acepta') === 'on',
            web: String(data.get('web') || ''),
          };

          submitBtn.disabled = true;
          msg.textContent = 'Enviando…';
          msg.className = 'text-xs text-gray-500';

          try {
            const res = await fetch('/api/avisar-donacion', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            if (!res.ok) throw new Error('Error ' + res.status);
            form.reset();
            msg.textContent = '¡Gracias! Registramos tu aviso.';
            msg.className = 'text-xs text-green-700';
          } catch {
            msg.textContent = 'No pudimos enviar el aviso. Puedes escribirnos a contacto@australdata.org.';
            msg.className = 'text-xs text-red-600';
          } finally {
            submitBtn.disabled = false;
          }
        });
    
  }

  document.addEventListener('astro:page-load', iniciarDonaciones);
</script>
