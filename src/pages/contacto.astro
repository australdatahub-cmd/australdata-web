---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contacto - AustralData.org</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-800 min-h-screen antialiased flex flex-col justify-between">
    
    <!-- Header Global -->
    <Header activePage="contacto" />

    <main class="max-w-2xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1 flex flex-col justify-center">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Contacto Institucional</h1>
        <p class="text-sm text-gray-500 mt-2">¿Tienes dudas sobre la ingesta de registros, derechos de autor o licencias?</p>
      </div>

      <div class="bg-white border border-gray-200/80 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6">
        <div class="space-y-4 text-xs text-gray-600">
          <div class="p-4 rounded-xl bg-blue-50/50 border border-blue-100 flex items-start gap-3">
            <svg class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <div>
              <span class="font-semibold text-gray-900 block mb-1">Correo Electrónico Oficial</span>
              <a href="mailto:hub@australdata.org" class="text-blue-600 font-medium hover:underline text-xs">contacto@australdata.org</a>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-gray-50 border border-gray-100 flex items-start gap-3">
            <svg class="w-5 h-5 text-gray-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            <div>
              <span class="font-semibold text-gray-900 block mb-1">Organización</span>
              <p>Fundación Austral de Observación Científica y Datos Abiertos</p>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer Global -->
    <Footer />

  </body>
</html>