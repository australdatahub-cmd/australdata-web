---
interface Props {
  activePage?: 'inicio' | 'biblioteca' | 'subir' | 'donaciones' | 'contacto';
}

const { activePage } = Astro.props;
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    
    <!-- Logo e Identidad AustralData.org -->
    <a href="/" class="flex items-center gap-3 group">
      <img 
        src="/Logo.svg" 
        alt="Logo Fundación Austral" 
        class="w-10 h-10 object-contain rounded-full border border-gray-100 shadow-xs group-hover:scale-105 transition-transform"
      />
      <div class="flex items-center">
        <span class="text-base font-bold text-gray-900 tracking-tight">AustralData.org</span>
      </div>
    </a>

    <!-- Enlaces Principales -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-gray-600">
      <a 
        href="/" 
        class={`px-3 py-2 rounded-lg transition ${activePage === 'inicio' ? 'bg-blue-50 text-blue-700 font-semibold' : 'hover:bg-gray-100 hover:text-gray-900'}`}
      >
        Inicio
      </a>
      <a 
        href="/biblioteca" 
        class={`px-3 py-2 rounded-lg transition ${activePage === 'biblioteca' ? 'bg-blue-50 text-blue-700 font-semibold' : 'hover:bg-gray-100 hover:text-gray-900'}`}
      >
        Biblioteca
      </a>
      <a 
        href="/subir" 
        class={`px-3 py-2 rounded-lg transition ${activePage === 'subir' ? 'bg-blue-50 text-blue-700 font-semibold' : 'hover:bg-gray-100 hover:text-gray-900'}`}
      >
        Subir
      </a>
      <a 
        href="/donaciones" 
        class={`px-3 py-2 rounded-lg transition ${activePage === 'donaciones' ? 'bg-blue-50 text-blue-700 font-semibold' : 'hover:bg-gray-100 hover:text-gray-900'}`}
      >
        Donaciones
      </a>
      <a 
        href="/contacto" 
        class={`px-3 py-2 rounded-lg transition ${activePage === 'contacto' ? 'bg-blue-50 text-blue-700 font-semibold' : 'hover:bg-gray-100 hover:text-gray-900'}`}
      >
        Contacto
      </a>
    </nav>

    <!-- Botón de Acción -->
    <a 
      href="/subir" 
      class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-4 py-2.5 rounded-full shadow-sm transition"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      Subir Registro
    </a>
  </div>
</header>