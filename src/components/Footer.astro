---
const year = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-200 py-8 text-center text-xs text-gray-500 mt-auto">
  <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="space-y-1">
      <div>
        &copy; {year} Fundación Austral de Observación Científica y Datos Abiertos.
      </div>
      <div class="text-gray-400">
        Registros reales y originales, gratuitos y de uso libre (CC0 1.0).
      </div>
    </div>
    <div class="flex items-center gap-4 font-medium text-gray-600">
      <a href="/biblioteca" class="hover:underline">Biblioteca</a>
      <a href="/subir" class="hover:underline">Subir</a>
      <a href="/donaciones" class="hover:underline">Donaciones</a>
      <a href="/contacto" class="hover:underline">Contacto</a>
      <a href="/documentos" class="hover:underline">Documentos</a>
      <a
        href="https://www.instagram.com/australdata"
        target="_blank"
        rel="noopener noreferrer me"
        aria-label="Instagram de AustralData"
        title="Instagram"
        class="text-gray-500 hover:text-gray-900 transition"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
    </div>
  </div>
</footer>
