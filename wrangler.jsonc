{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "australdata-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "australdata-stats",
			"database_id": "621e3467-609b-4ee4-99e1-350a44626880"
		}
	],
	"observability": {
		"enabled": true
	}
}
